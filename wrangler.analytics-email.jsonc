{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "county-analytics-email-sender",
  "main": "./workers/email-sender/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "REPORT_FROM": "County Atlas Analytics <analytics@reports.markstruck.com>",
    "REPORT_TO": "markstruck@comcast.net"
  }
}
